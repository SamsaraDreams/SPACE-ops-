# Copia este archivo como .env y llena los valores.
# NUNCA lo subas a git: .gitignore ya lo excluye.
#
# Ojo: Hermes pasa a los subprocesos MCP solo las variables declaradas en
# el bloque env de config.yaml, mas una base segura. Tener algo aqui no
# basta; tambien tiene que estar declarado alla.

# Credenciales OAuth de la cuenta dedicada del agente.
# Lo genera el flujo de autorizacion la primera vez.
GOOGLE_TOKEN_PATH=/home/USUARIO/space-ops/token.json

# La COPIA de prueba de VENTAS SPACE 2.0, no la hoja real.
# Es la parte larga de la URL, entre /d/ y /edit.
SHEET_ID=

# Calendario compartido del equipo. No el personal de nadie.
CALENDAR_ID=

# Zona horaria. Las fechas de Calendar sin zona se interpretan como UTC,
# lo que correria las citas seis horas.
TZ=America/Mexico_City

# DEBUG mientras pruebas, INFO en uso normal.
SPACE_OPS_LOG=INFO
